  m_Text: "\uCE5C\uAD6C\uC640\uC758 \uC57D\uC18D \uC7A5\uC18C\uB97C \uAC00\uAE30
    \uC704\uD574 \uC9C0\uD558\uCCA0\uC5D0 \uB3C4\uCC29\uD558\uC600\uC2B5\uB2C8\uB2E4.\n\n\r\n\uC57D\uC18D
